<?xml version="1.0" encoding="utf-8"?>
<!--
    Status bar / pill icon. Android re-colors every non-transparent pixel to a
    single flat color automatically (white on dark backgrounds, black on light) —
    the fill/stroke colors below don't actually matter, only the SHAPE does.
    A simple crosshair/reticle, fitting for a match-tracking app.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:pathData="M12,2 L12,7"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <path
        android:pathData="M12,17 L12,22"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <path
        android:pathData="M2,12 L7,12"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <path
        android:pathData="M17,12 L22,12"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <path
        android:pathData="M12,12m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2" />
</vector>
